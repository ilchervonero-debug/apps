rules_version = '2';
// Reglas de seguridad Firestore — compartidas por Bitácora y SketchVolt (mismo proyecto bitacorapp-3df06).
// Aislamiento por usuario vía la RUTA: todo cuelga de usuarios/{uid}/... y solo el dueño del token entra.
// Es la "validación estricta" del spec: el uid sale de request.auth (token), no del cliente; lo ajeno =
// permission-denied (equivalente al 403 Forbidden).
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo lo del usuario (bitácora en .../proyectos y sketchvolt en .../sketchvolt) queda protegido acá.
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Resto: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
