{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'sitio estatico: index.html ya viene generado'",
  "outputDirectory": "chervo-web",
  "alias": ["ilchervo.com"],
  "rewrites": [
    { "source": "/ilframe", "destination": "/ilframe/index.html" },
    { "source": "/ilframe/:path*", "destination": "/ilframe/index.html" },
    { "source": "/apps/cielorraso", "destination": "/apps/cielorraso/index.html" },
    { "source": "/del-trazo-al-pixel", "destination": "/del-trazo-al-pixel.html" },
    { "source": "/del-trazo-al-pixel/", "destination": "/del-trazo-al-pixel.html" },
    { "source": "/del-trazo-al-pixel/manifest.webmanifest", "destination": "/del-trazo-al-pixel.webmanifest" },
    { "source": "/del-trazo-al-pixel/sw.js", "destination": "/del-trazo-al-pixel-sw.js" },
    { "source": "/del-trazo-al-pixel/icon.svg", "destination": "/del-trazo-al-pixel-icon.svg" },
    { "source": "/del-trazo-al-pixel/icon-maskable.svg", "destination": "/del-trazo-al-pixel-maskable.svg" }
  ],
  "headers": [
    {
      "source": "/(.*\\.html|)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
